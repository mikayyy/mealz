{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile && pnpm --dir frontend install --frozen-lockfile",
  "buildCommand": "pnpm --dir frontend build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.{js,ts}": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
